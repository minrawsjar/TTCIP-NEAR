# SMS Handler - Copy to .env
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ADMIN_TOKEN=admin123

# Twilio (webhook receives at /sms/incoming)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Backend (required for JOIN, BALANCE, SWAP, REDEEM)
BACKEND_URL=http://localhost:3000

# NEAR (for local fallback)
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_POOL_CONTRACT=ttcip-pool-v2.yourname.testnet
TXTC_TOKEN_CONTRACT=txtc.token.primitives.testnet
NEAR_OWNER_ACCOUNT=yourname.testnet

# Database (optional - enables /admin/wallets for recipient lookup)
# DATABASE_URL=postgresql://user:pass@localhost:5432/textchain
